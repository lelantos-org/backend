set shell := ["bash", "-ceuo", "pipefail"]

export FOUNDRY_DISABLE_NIGHTLY_WARNING := "1"

# Compose profile to act on. Override: `just PROFILE=fmd up`.
PROFILE := "all"

# Which config/<env>/ directory the services mount their TOMLs from.
# `dev` = anvil/31337 placeholders filled in by the deploy one-shot.
# `prod` = mainnet templates; expects real signer keys in the environment.
export STACK_ENV := env_var_or_default("STACK_ENV", "dev")

# DEBUG=1 adds verbose detail to the stack scripts (host + deploy container);
# TRACE=1 additionally turns on `set -x`.
export DEBUG := env_var_or_default("DEBUG", "0")
export TRACE := env_var_or_default("TRACE", "0")

# Must be the release whose verifying keys are baked into
# `contracts/src/verifiers/` — currently v0.15.0. A mismatch fails silently
# until the first flush: the relayer proves fine and `flushBatch` reverts
# `TreeUpdateRejected()`. v0.12.0 through v0.15.0 share the shape (tree depth 11,
# `MAX_L_BATCH` 8, 4x6 transact) but each re-ran the setup, so their keys differ.
# v0.11.2 and earlier are depth 10 / MAX_L 4 / 4x4 — the witness graph then
# rejects `frontier_in[30..32]` and no proof the relayer builds can land.
CIRCUITS_VERSION := env_var_or_default("CIRCUITS_VERSION", "v0.15.0")

DC := "docker compose"
# Almost every recipe acts on the active profile; spelling it once keeps the
# recipes below down to the verb they actually run.
DCP := DC + " --profile " + PROFILE

# Backends that read per-chain values out of addresses.env, and so must be
# restarted when a redeploy mints new addresses. A container keeps the
# environment it started with, so nothing else picks the new values up.
#
# rpc-proxy is the one where a stale entry is silent rather than noisy: its
# contract allowlist comes from the seeds in addresses.env, so a missed restart
# leaves it refusing every read of the freshly deployed tokens.
ADDRESS_CONSUMERS := "ingester|relayer|metaquoter|registry-webserver|protocol-indexer|rpc-proxy"

default:
    @just --list

# ── circuits ────────────────────────────────────────────────────────────
#
# Artifacts land in ./circuits/ and are mounted into the relayer at
# /circuits:ro. Cached by tag via ./circuits/.version.

# Fetch tree_update_batch circuit artifacts from the circuits GH release.
fetch-circuits:
    CIRCUITS_VERSION={{CIRCUITS_VERSION}} ./scripts/fetch-circuits.sh

# Force re-fetch (drop the cached .version sentinel).
refetch-circuits:
    rm -f ./circuits/.version
    just fetch-circuits

# ── lifecycle ───────────────────────────────────────────────────────────

# Bring stack up (postgres + anvil + deploy + all backends). Default profile=all.
up: fetch-circuits
    {{DCP}} up

# Same, detached.
up-d: fetch-circuits
    {{DCP}} up -d

# Same, rebuild images first (after crate edits).
up-build: fetch-circuits
    {{DCP}} up --build

# Bring up a single profile (positional override of PROFILE).
up-profile P:
    just PROFILE={{P}} up

# Stop everything + wipe pg/addresses volumes.
down:
    {{DCP}} down -v

# Stop without wiping volumes.
stop:
    {{DCP}} stop

# Restart a single service.
restart SVC:
    {{DC}} restart {{SVC}}

# Re-run the forge deploy against the running anvil (new nonce → new addresses).
redeploy:
    {{DCP}} up --force-recreate --no-deps deploy
    @running="$({{DCP}} ps --services --status running \
        | grep -Ex '{{ADDRESS_CONSUMERS}}' | tr '\n' ' ')"; \
    if [ -n "$running" ]; then \
        echo "restarting to re-source addresses.env: $running"; \
        {{DC}} restart $running; \
    else \
        echo "no address-consuming backends running"; \
    fi

# ── inspection ──────────────────────────────────────────────────────────

# Resolved settings + which config dir is active.
env:
    @echo "PROFILE={{PROFILE}} STACK_ENV={{STACK_ENV}} DEBUG={{DEBUG}} TRACE={{TRACE}}"
    @echo "configs mounted from ./config/{{STACK_ENV}}/:"
    @ls -1 ./config/{{STACK_ENV}}/

# Fully resolved compose config (anchors expanded, vars interpolated).
config:
    {{DCP}} config

# List services + status for the active profile.
ps:
    {{DCP}} ps

# Tail logs for one service (last 200 lines, follow).
logs SVC:
    {{DC}} logs -n 200 -f {{SVC}}

# All logs for active profile (follow).
logs-all:
    {{DCP}} logs -f

# Output of the last deploy one-shot (contract addresses, funding, errors).
deploy-logs:
    {{DC}} logs deploy

# This is what every backend sources at startup — check here first when a
# service behaves as if a contract address were missing.

# Dump addresses.env as written by the deploy one-shot.
addresses:
    {{DC}} run --rm --no-deps --entrypoint cat deploy /addresses/addresses.env

# ── yield ───────────────────────────────────────────────────────────────

# ID is a yield asset id (4, 5, 6 on the dev fixture — the plain ids 1-3 are
# custody only and have no vault). AMT is in the token's base units. Deposit
# into the asset first: the credit is shared out over the shares the pool
# already holds, and there are none until a deposit has settled.
#
#   just earn 4 5000000000000000000   # 5 WETH into the WETH yield asset
#
# `--no-deps` because anvil is already up; the deploy one-shot is reused only
# for its foundry image and its /addresses mount.

# Credit interest on a yield asset's mock vault, raising its index.
earn ID AMT:
    {{DC}} run --rm --no-deps --entrypoint /scripts/earn.sh deploy {{ID}} {{AMT}}

# psql shell into the running postgres.
db-shell:
    {{DC}} exec postgres psql -U postgres -d postgres

# Shell into a service container.
sh SVC:
    {{DC}} exec {{SVC}} /bin/sh

# Globbed rather than named after the service: each container mounts exactly
# one TOML under /etc/, and the filename does not always match the service
# (registry-webserver mounts /etc/registry.toml).

# Effective TOML a service actually mounted (post STACK_ENV selection).
show-config SVC:
    {{DC}} exec {{SVC}} sh -c 'cat /etc/*.toml'

# ── checks ──────────────────────────────────────────────────────────────

# Validate compose + shell scripts + every config TOML, for both envs.
check:
    @for env in dev prod; do \
        echo "== compose (STACK_ENV=$env)"; \
        STACK_ENV=$env {{DC}} --profile all config -q; \
    done
    @echo "== shell scripts"
    bash -n ./scripts/fetch-circuits.sh
    sh -n ./scripts/deploy-contracts.sh
    sh -n ./scripts/earn.sh
    @echo "== config TOMLs"
    @for f in ./config/*/*.toml; do \
        python3 -c "import tomllib,sys; tomllib.load(open(sys.argv[1],'rb'))" "$f" \
            && echo "  ok $f" || exit 1; \
    done
    @# A missing TOML is not a compose error: Docker creates a *directory* at an
    @# absent bind source and mounts that, so the service fails at runtime with a
    @# config it cannot read. Checking the sources is what catches a config/<env>/
    @# that has fallen behind the service list.
    @echo "== bind mounts resolve (both envs)"
    @for env in dev prod; do \
        STACK_ENV=$env {{DC}} --profile all config --format json \
            | jq -r '.services | to_entries[] | .key as $s | (.value.volumes // [])[] \
                     | select(.type=="bind") | "\($s) \(.source)"' \
            | while read -r svc src; do \
                [ -e "$src" ] || { echo "  MISSING ($env) $svc -> $src"; exit 1; }; \
              done || exit 1; \
        echo "  ok $env"; \
    done
